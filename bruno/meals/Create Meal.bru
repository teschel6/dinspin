meta {
  name: Create Meal
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/meals
  body: json
  auth: none
}

body:json {
  {
    "description": "Test Meal"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.description: eq "Test Meal"
}

vars:post-response {
  mealId: res.body.id
}
